{
  "name": "My Verisure Development",
  "image": "ghcr.io/home-assistant/home-assistant:2026.11.2",
  "appPort": [
    "7123:8123"
  ],
  "postCreateCommand": "python3 -m venv --system-site-packages /opt/my-verisure-validation && /opt/my-verisure-validation/bin/python -m pip install -r requirements-dev.txt",
  "mounts": [
    "type=volume,source=my_verisure_devcontainer_config,target=/config",
    "type=bind,source=${localWorkspaceFolder}/custom_components/my_verisure,target=/config/custom_components/my_verisure,readonly",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer/configuration.yaml,target=/config/configuration.yaml,readonly",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer/automations.yaml,target=/config/automations.yaml,readonly",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer/scripts.yaml,target=/config/scripts.yaml,readonly",
    "type=bind,source=${localWorkspaceFolder}/.devcontainer/scenes.yaml,target=/config/scenes.yaml,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "visualstudioexptteam.vscodeintellicode",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/my-verisure-validation/bin/python",
        "editor.formatOnSave": false,
        "python.testing.pytestEnabled": true,
        "files.eol": "\n",
        "editor.tabSize": 4,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [
    8123
  ],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "HA_PYTHON": "/opt/my-verisure-validation/bin/python"
  }
}
