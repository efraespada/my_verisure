#!/usr/bin/env bash
# Development helper. Verification delegates to the canonical Makefile.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
HA_PYTHON="${HA_PYTHON:-${SCRIPT_DIR}/.ha-2026.11-venv/bin/python}"
export HA_PYTHON
HA_CONFIG="${HA_CONFIG:-/config}"
DOCKER_CONTAINER="my_verisure_dev"
DOCKER_IMAGE="ghcr.io/home-assistant/home-assistant:2026.11.2"

usage() {
    cat <<'HELP'
My Verisure development helper

  setup          Create Python 3.14 environment and install pinned dependencies
  test           Run complete pinned Home Assistant/Core/CLI suite
  test-cli       Run CLI suite
  test-core      Run application/core suite
  coverage       Run contextual coverage and notification coverage gate
  lint           Run complete Flake8 baseline
  type-check     Run complete mypy gate
  check          Run all canonical release gates (make ci)
  deps           Install pinned development dependencies
  start          Run HA in foreground (HA_CONFIG defaults to /config)
  config         Validate HA_CONFIG without starting HA
  logs           Follow HA_CONFIG/home-assistant.log
  devcontainer   Open the project in Cursor or VS Code
  docker-start   Start pinned HA; retain its named config volume
  docker-stop    Stop pinned HA without deleting its configuration
  docker-logs    Follow Docker logs
  docker-shell   Open Docker shell
  version        Show integration and selected interpreter versions
  help           Show this message

HA_PYTHON can select an existing validation environment. Docker configuration
is stored in the my_verisure_dev_config named volume, outside the repository.
HELP
}

case "${1:-help}" in
    help) usage ;;
    setup)
        if [[ "$HA_PYTHON" != */* ]]; then
            command -v "$HA_PYTHON" >/dev/null 2>&1 || {
                echo "HA_PYTHON does not identify an existing interpreter." >&2
                exit 2
            }
        elif [[ ! -x "$HA_PYTHON" ]]; then
            python3.14 -m venv "$(dirname "$(dirname "$HA_PYTHON")")"
        fi
        make install
        ;;
    test) make test-ha-2026-11 ;;
    test-cli) make test-cli ;;
    test-core) make test-core ;;
    coverage) make coverage ;;
    lint) make lint ;;
    type-check) make type-check ;;
    check) make ci ;;
    deps) make install ;;
    start) exec "$HA_PYTHON" -m homeassistant --config "$HA_CONFIG" ;;
    config) exec "$HA_PYTHON" -m homeassistant --config "$HA_CONFIG" --script check_config ;;
    logs) exec tail -f "$HA_CONFIG/home-assistant.log" ;;
    devcontainer)
        if command -v cursor >/dev/null 2>&1; then
            exec cursor .
        elif command -v code >/dev/null 2>&1; then
            exec code .
        else
            echo "Install the Cursor or VS Code shell command and Dev Containers extension." >&2
            exit 1
        fi
        ;;
    docker-start)
        if docker container inspect "$DOCKER_CONTAINER" >/dev/null 2>&1; then
            docker start "$DOCKER_CONTAINER"
        else
            docker run -d --name "$DOCKER_CONTAINER" \
                -p 127.0.0.1:8123:8123 \
                -v my_verisure_dev_config:/config \
                -v "$SCRIPT_DIR/custom_components/my_verisure:/config/custom_components/my_verisure:ro" \
                -v "$SCRIPT_DIR/.devcontainer/configuration.yaml:/config/configuration.yaml:ro" \
                -v "$SCRIPT_DIR/.devcontainer/automations.yaml:/config/automations.yaml:ro" \
                -v "$SCRIPT_DIR/.devcontainer/scripts.yaml:/config/scripts.yaml:ro" \
                -v "$SCRIPT_DIR/.devcontainer/scenes.yaml:/config/scenes.yaml:ro" \
                "$DOCKER_IMAGE"
        fi
        echo "Home Assistant: http://localhost:8123 (use docker-logs to check readiness)."
        echo "Existing containers keep their original image and storage; back them up before migration."
        ;;
    docker-stop) docker stop "$DOCKER_CONTAINER" ;;
    docker-logs) exec docker logs -f "$DOCKER_CONTAINER" ;;
    docker-shell) exec docker exec -it "$DOCKER_CONTAINER" /bin/bash ;;
    version)
        "$HA_PYTHON" -c 'import json, sys; from pathlib import Path; print("My Verisure", json.loads(Path("custom_components/my_verisure/manifest.json").read_text())["version"]); print(sys.version)'
        ;;
    *) echo "Unknown command: $1. Run ./dev help." >&2; exit 1 ;;
esac
