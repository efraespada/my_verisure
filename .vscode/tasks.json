      "type": "shell",
      "command": "make test-ha-2026-11",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Lint: Flake8 critical",
      "type": "shell",
      "command": "make lint-critical",
      "problemMatcher": []
    },
    {
      "label": "Type Check: MyPy",
      "type": "shell",
      "command": "make type-check",
      "problemMatcher": []
    }
  ]
