{
  "python.defaultInterpreterPath": "${workspaceFolder}/.ha-2026.11-venv/bin/python",
  "editor.formatOnSave": false,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    "-c",
    "pytest.ini"
  ],
  "files.eol": "\n",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[python]": {
    "editor.rulers": [
      88
    ],
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced"
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/htmlcov": true,
    "**/.coverage": true
  },
  "search.exclude": {
    "**/venv": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/htmlcov": true,
    "**/.ha-2026.11-venv": true
  }
}
